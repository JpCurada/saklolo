    "/cases/{case_id}/confirm-safe": {
      "post": {
        "tags": [
          "cases"
        ],
        "summary": "Confirm Safe",
        "operationId": "confirm_safe_cases__case_id__confirm_safe_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
