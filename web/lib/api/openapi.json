              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "replay"
        ],
        "summary": "Start Replay",
        "operationId": "start_replay_replay_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
