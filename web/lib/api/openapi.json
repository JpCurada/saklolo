  "components": {
    "schemas": {
      "AssignIn": {
        "properties": {
          "dispatcher": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Dispatcher",
            "description": "Who made the decision; recorded in the case history"
          },
          "team": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Team"
          }
        },
        "type": "object",
        "required": [
          "dispatcher",
          "team"
        ],
        "title": "AssignIn"
      },
      "Badge": {
        "type": "string",
        "enum": [
          "corroborated",
          "suspicious",
          "reported_safe",
          "awaiting_location",
          "needs_review",
          "overridden"
        ],
        "title": "Badge"
      },
      "CaseAction": {
        "type": "string",
        "enum": [
          "assigned",
          "overridden",
          "closed"
        ],
        "title": "CaseAction"
      },
      "CaseEvent": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/CaseAction"
          },
          "dispatcher": {
            "type": "string",
            "title": "Dispatcher"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "action",
          "dispatcher",
          "at",
          "detail"
        ],
        "title": "CaseEvent",
        "description": "One dispatcher decision, kept so every change has a named person behind it."
      },
      "CaseStatus": {
        "type": "string",
        "enum": [
          "open",
          "assigned",
          "closed"
        ],
        "title": "CaseStatus"
      },
      "CaseView": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "priority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Priority"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority_overridden": {
            "type": "boolean",
            "title": "Priority Overridden"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "english_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "English Summary"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "people_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "People Count"
          },
          "vulnerable": {
            "items": {
              "$ref": "#/components/schemas/Vulnerability"
            },
            "type": "array",
            "title": "Vulnerable"
          },
          "water_level": {
            "$ref": "#/components/schemas/WaterLevel"
          },
          "medical_emergency": {
            "type": "boolean",
            "title": "Medical Emergency"
          },
          "badges": {
            "items": {
              "$ref": "#/components/schemas/Badge"
            },
            "type": "array",
            "title": "Badges"
          },
          "assigned_team": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned Team"
          },
          "opened_at": {
            "type": "string",
            "format": "date-time",
            "title": "Opened At"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceView"
            },
            "type": "array",
            "title": "Sources"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/CaseEvent"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "status",
          "priority",
          "priority_overridden",
          "reason",
          "english_summary",
          "location",
          "people_count",
          "vulnerable",
          "water_level",
          "medical_emergency",
          "badges",
          "assigned_team",
          "opened_at",
          "last_seen",
          "sources",
          "history"
        ],
        "title": "CaseView"
      },
      "Channel": {
        "type": "string",
        "enum": [
          "sms",
          "messenger",
          "telegram",
          "web"
        ],
        "title": "Channel"
      },
      "DispatcherIn": {
        "properties": {
          "dispatcher": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Dispatcher",
            "description": "Who made the decision; recorded in the case history"
          }
        },
        "type": "object",
        "required": [
          "dispatcher"
        ],
        "title": "DispatcherIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InboundMessage": {
        "properties": {
          "sender": {
            "type": "string",
            "title": "Sender"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          }
        },
        "type": "object",
        "required": [
          "sender",
          "text",
          "channel",
          "received_at"
        ],
        "title": "InboundMessage",
        "description": "What every channel adapter sends to intake (ADR 0001)."
      },
      "Location": {
        "properties": {
          "barangay": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Barangay"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lng": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lng"
          },
          "source": {
            "$ref": "#/components/schemas/LocationSource",
            "default": "unknown"
          }
        },
        "type": "object",
        "required": [
          "barangay"
        ],
        "title": "Location"
      },
      "LocationSource": {
        "type": "string",
        "enum": [
          "text",
          "geocoder",
          "reply",
          "unknown"
        ],
        "title": "LocationSource"
      },
      "MessageIn": {
        "properties": {
          "sender": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Sender"
          },
          "text": {
            "type": "string",
            "maxLength": 1600,
            "minLength": 1,
            "title": "Text"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel",
            "default": "web"
          },
          "received_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Received At",
            "description": "Defaults to now"
          }
        },
        "type": "object",
        "required": [
          "sender",
          "text"
        ],
        "title": "MessageIn"
      },
      "MessageRecord": {
        "properties": {
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "message": {
            "$ref": "#/components/schemas/InboundMessage"
          },
          "kind": {
            "$ref": "#/components/schemas/ReceiveKind"
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TriageOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "case_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
            "type": "array",
            "title": "Trace"
          }
        },
        "type": "object",
        "required": [
          "message_id",
          "message",
          "kind",
          "outcome",
          "case_id"
        ],
        "title": "MessageRecord",
        "description": "One received message and what the pipeline made of it."
      },
      "OutboundMessage": {
        "properties": {
          "recipient": {
            "type": "string",
            "title": "Recipient"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "title": "Sent At"
          }
        },
        "type": "object",
        "required": [
          "recipient",
          "body",
          "sent_at"
        ],
        "title": "OutboundMessage",
        "description": "A text sent to a resident (through the Notifier port)."
      },
      "OverrideIn": {
        "properties": {
          "dispatcher": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Dispatcher",
            "description": "Who made the decision; recorded in the case history"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "reason": {
            "type": "string",
            "maxLength": 1600,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "dispatcher",
          "priority",
          "reason"
        ],
        "title": "OverrideIn"
      },
      "Priority": {
        "type": "string",
        "enum": [
          "P1",
          "P2",
          "P3",
          "P4"
        ],
        "title": "Priority"
      },
      "ReceiveKind": {
        "type": "string",
        "enum": [
          "triaged",
          "location_reply"
        ],
        "title": "ReceiveKind"
      },
      "ReceiveResult": {
        "properties": {
          "record": {
            "$ref": "#/components/schemas/MessageRecord"
          },
          "replies": {
            "items": {
              "$ref": "#/components/schemas/OutboundMessage"
            },
            "type": "array",
            "title": "Replies"
          }
        },
        "type": "object",
        "required": [
          "record",
          "replies"
        ],
        "title": "ReceiveResult"
      },
      "ReplayIn": {
        "properties": {
          "split": {
            "type": "string",
            "pattern": "^(dev|calibration)$",
            "title": "Split",
            "default": "dev"
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Speed",
            "description": "Storm seconds per real second",
            "default": 3600.0
          },
          "max_delay_s": {
            "type": "number",
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Max Delay S",
            "default": 2.0
          }
        },
        "type": "object",
        "title": "ReplayIn"
      },
      "ReplayStatus": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "split": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Split"
          },
          "sent": {
            "type": "integer",
            "title": "Sent"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "running",
          "split",
          "sent",
          "total"
        ],
        "title": "ReplayStatus"
      },
      "SourceView": {
        "properties": {
          "message_id": {
            "type": "string",
            "title": "Message Id"
          },
          "sender": {
            "type": "string",
            "title": "Sender"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "received_at": {
            "type": "string",
            "format": "date-time",
            "title": "Received At"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "The resident's original words"
          },
          "english_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "English Summary"
          },
          "priority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Priority"
              },
              {
                "type": "null"
              }
            ]
          },
          "trace": {
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
