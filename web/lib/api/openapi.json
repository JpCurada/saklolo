        ],
        "summary": "Override",
        "operationId": "override_cases__case_id__override_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OverrideIn"
              }
            }
          }
        },
        "responses": {
          "200": {
