{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript lib/api/openapi.json -o lib/api/schema.d.ts",
    "predev": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "tokens": "node --experimental-strip-types --no-warnings scripts/build-tokens.ts",
    "ui:check": "node scripts/ui-check.mjs",
    "assets": "node scripts/build-assets.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
