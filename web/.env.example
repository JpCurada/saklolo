# Copy to .env.local (never commit it). Both are read at build time.

# Where the browser reaches the Saklolo API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# true shows the demo tools: storm replay and the /resident phones. Leave it unset
# for any deployment a real dispatcher uses.
NEXT_PUBLIC_DEMO_MODE=

# Dispatcher sign-in. Set all three (from `terraform output`) to require Cognito sign-in;
# leave them empty to run open against a local API.
NEXT_PUBLIC_COGNITO_AUTHORITY=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
