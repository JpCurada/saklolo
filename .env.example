# Copy to .env and fill in. Never commit .env.

AWS_REGION=ap-southeast-1
AWS_PROFILE=saklolo-dev

# Bedrock model IDs: check model access and the exact IDs in the Bedrock console.
SAKLOLO_FAST_MODEL_ID=
SAKLOLO_STRONG_MODEL_ID=
SAKLOLO_EMBEDDING_MODEL_ID=

# Triage below this confidence is escalated to the Swarm, then to human review.
SAKLOLO_ESCALATION_THRESHOLD=0.75

# Amazon Location Service place index (TODO: not yet created by infra/).
SAKLOLO_PLACE_INDEX=

# SQS intake queue and DynamoDB tables (created by infra/; see its outputs).
SAKLOLO_INTAKE_QUEUE_URL=
SAKLOLO_CASES_TABLE=
SAKLOLO_MESSAGES_TABLE=
