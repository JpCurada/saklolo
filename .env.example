# Copy to .env and fill in. Never commit .env.

AWS_REGION=ap-southeast-1
# Leave unset to use the default AWS CLI profile.
AWS_PROFILE=

# Bedrock model IDs: check model access and the exact IDs in the Bedrock console.
# Nova is Amazon's own model (billed as Bedrock, usually covered by credits).
SAKLOLO_FAST_MODEL_ID=apac.amazon.nova-lite-v1:0
# USD per million tokens for the fast model (Bedrock pricing page); drives cost metrics.
SAKLOLO_FAST_MODEL_INPUT_PRICE=0.06
SAKLOLO_FAST_MODEL_OUTPUT_PRICE=0.24
SAKLOLO_STRONG_MODEL_ID=

# Triage below this confidence is escalated to the Swarm, then to human review.
SAKLOLO_ESCALATION_THRESHOLD=0.75

# Services not offered in ap-southeast-1 get their own region (ADR 0005).
SAKLOLO_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
SAKLOLO_EMBEDDING_REGION=us-east-1
SAKLOLO_LOCATION_REGION=ap-southeast-2

# Dedupe (ADR 0003). Tune on the dev split only.
SAKLOLO_DEDUPE_SIMILARITY_THRESHOLD=0.85
SAKLOLO_DEDUPE_WINDOW_HOURS=12
SAKLOLO_DEDUPE_RADIUS_KM=1.5

# SQS intake queue and DynamoDB tables (created by infra/; see its outputs).
# JSON list of dashboard addresses allowed to call the API.
SAKLOLO_DASHBOARD_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

SAKLOLO_INTAKE_QUEUE_URL=
SAKLOLO_CASES_TABLE=
SAKLOLO_MESSAGES_TABLE=
SAKLOLO_DISPATCH_TABLE=

# Chat-app channels (docs/channels.md). Each is off until its secrets are set.
SAKLOLO_TELEGRAM_BOT_TOKEN=
SAKLOLO_MESSENGER_PAGE_TOKEN=
SAKLOLO_MESSENGER_APP_SECRET=
SAKLOLO_MESSENGER_VERIFY_TOKEN=
SAKLOLO_MESSENGER_GRAPH_VERSION=v23.0
